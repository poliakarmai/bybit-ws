[Unit]
Description=bybit-ws trading engine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/bybit-ws
WorkingDirectory=%h/.local/lib/bybit_ws
Restart=always
RestartSec=10
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=%h/.config/bybit-ws/.env

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/bybit-ws
ReadWritePaths=%h/.config/bybit-ws
ReadWritePaths=/opt/vpn-core/conf

[Install]
WantedBy=default.target
